# Modèle de configuration locale : copier en .env (non versionné) et remplacer chaque <placeholder>.
# Ne jamais mettre de valeur réelle dans ce fichier. Détail : docs/deploiement.md.
# Chargement : set -a; source .env; set +a
# Les guillemets simples protègent les « $ » du condensé bcrypt.

# Obligatoire : condensé bcrypt (coût 10 à 31) du mot de passe du compte local.
RECUS_SECURITE_CONDENSE_MOT_DE_PASSE='<condensé bcrypt>'

# Obligatoire : 32 octets aléatoires en base 64 (openssl rand -base64 32).
RECUS_GOOGLE_CLE_CHIFFREMENT='<openssl rand -base64 32>'

# Facultatifs : identifiants du client OAuth2 Google (sans eux, l'autorisation reste ABSENTE).
RECUS_GOOGLE_CLIENT_ID='<identifiant du client OAuth2>'
RECUS_GOOGLE_CLIENT_SECRET='<secret du client OAuth2>'

# Clé du modèle (Anthropic).
ANTHROPIC_API_KEY='<clé API Anthropic>'

# Dossier de la base SQLite et des photos (volume conservé, hors de la racine web).
RECUS_DOSSIER_DONNEES=data

# Fichier et onglet du Google Sheet, une année à la fois.
RECUS_COPIE_ANNEES_2026_FICHIER='<identifiant du Google Sheet>'
RECUS_COPIE_ANNEES_2026_ONGLET=<nom de l'onglet>

# Mode dev seulement (HTTP sur le poste ou le réseau local) ; jamais en production.
# SPRING_PROFILES_ACTIVE=dev
