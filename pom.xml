<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/>
  </parent>

  <groupId>ca.gestionchalet</groupId>
  <artifactId>gestion-chalet</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>gestion-chalet</name>

  <properties>
    <java.version>25</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <spring-ai.version>2.0.2</spring-ai.version>
    <archunit.version>1.5.1</archunit.version>
    <spotbugs-plugin.version>4.10.5.0</spotbugs-plugin.version>
    <findsecbugs.version>1.14.0</findsecbugs.version>
    <dependency-check.version>13.0.0</dependency-check.version>
    <build-helper-plugin.version>3.6.2</build-helper-plugin.version>
    <exec-plugin.version>3.6.4</exec-plugin.version>
    <mapstruct.version>1.6.3</mapstruct.version>
    <jacoco.version>0.8.15</jacoco.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.ai</groupId>
        <artifactId>spring-ai-bom</artifactId>
        <version>${spring-ai.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security-oauth2-client</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-liquibase</artifactId>
    </dependency>
    <dependency>
      <groupId>org.hibernate.orm</groupId>
      <artifactId>hibernate-community-dialects</artifactId>
    </dependency>
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.mapstruct</groupId>
      <artifactId>mapstruct</artifactId>
      <version>${mapstruct.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-starter-model-anthropic</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>org.mapstruct</groupId>
              <artifactId>mapstruct-processor</artifactId>
              <version>${mapstruct.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <!-- Les tests ne dépendent pas du terminal de celui qui les lance : une variable d'environnement (ex. un .env chargé) passe avant
           les fichiers de configuration. Surefire n'accepte que des noms exacts, pas de motif ; TestEnvironmentIsolationTest échoue si une
           variable RECUS_* oubliée ici atteint la JVM des tests. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <excludedEnvironmentVariables>
            <excludedEnvironmentVariable>RECUS_MODELE</excludedEnvironmentVariable>
            <excludedEnvironmentVariable>RECUS_DOSSIER_DONNEES</excludedEnvironmentVariable>
            <excludedEnvironmentVariable>RECUS_DOSSIER_PHOTOS</excludedEnvironmentVariable>
            <excludedEnvironmentVariable>RECUS_FUSEAU_HORAIRE</excludedEnvironmentVariable>
            <excludedEnvironmentVariable>RECUS_PHOTOS_PAR_RECU_MAX</excludedEnvironmentVariable>
            <excludedEnvironmentVariable>RECUS_DIMENSIONS_MAX_MEGAPIXELS</excludedEnvironmentVariable>
            <excludedEnvironmentVariable>RECUS_LECTURE_DELAI</excludedEnvironmentVariable>
            <excludedEnvironmentVariable>RECUS_LECTURE_LECTURES_PAR_HEURE</excludedEnvironmentVariable>
            <excludedEnvironmentVariable>RECUS_LECTURE_COTE_MAX_PIXELS</excludedEnvironmentVariable>
            <excludedEnvironmentVariable>RECUS_LECTURE_COTE_SOURCE_MAX_PIXELS</excludedEnvironmentVariable>
            <excludedEnvironmentVariable>RECUS_LECTURE_DECODAGES_SIMULTANES</excludedEnvironmentVariable>
            <excludedEnvironmentVariable>RECUS_LECTURE_PASSES_DECODAGE_MAX</excludedEnvironmentVariable>
            <excludedEnvironmentVariable>RECUS_LECTURE_DELAI_DECODAGE</excludedEnvironmentVariable>
            <excludedEnvironmentVariable>RECUS_LECTURE_ATTENTE_DECODAGE</excludedEnvironmentVariable>
            <excludedEnvironmentVariable>RECUS_ALERTES_SEUIL_NUMEROS_INSCRIPTION_CENTS</excludedEnvironmentVariable>
            <excludedEnvironmentVariable>RECUS_ALERTES_SEUIL_PIECE_A_VERIFIER_CENTS</excludedEnvironmentVariable>
            <excludedEnvironmentVariable>RECUS_ALERTES_ECART_TOLERE_CENTS</excludedEnvironmentVariable>
            <excludedEnvironmentVariable>RECUS_GOOGLE_CLE_CHIFFREMENT</excludedEnvironmentVariable>
            <excludedEnvironmentVariable>RECUS_GOOGLE_CLIENT_ID</excludedEnvironmentVariable>
            <excludedEnvironmentVariable>RECUS_GOOGLE_CLIENT_SECRET</excludedEnvironmentVariable>
            <excludedEnvironmentVariable>RECUS_GOOGLE_DELAI_APPEL</excludedEnvironmentVariable>
            <excludedEnvironmentVariable>RECUS_GOOGLE_ADRESSE_CONSENTEMENT</excludedEnvironmentVariable>
            <excludedEnvironmentVariable>RECUS_GOOGLE_ADRESSE_JETON</excludedEnvironmentVariable>
            <excludedEnvironmentVariable>RECUS_GOOGLE_ADRESSE_RAPPEL</excludedEnvironmentVariable>
            <excludedEnvironmentVariable>RECUS_COPIE_AUTOMATIQUE</excludedEnvironmentVariable>
            <excludedEnvironmentVariable>RECUS_COPIE_INTERVALLE</excludedEnvironmentVariable>
            <excludedEnvironmentVariable>RECUS_COPIE_DELAI_APPEL</excludedEnvironmentVariable>
            <excludedEnvironmentVariable>RECUS_COPIE_DOSSIER_DRIVE</excludedEnvironmentVariable>
            <excludedEnvironmentVariable>RECUS_COPIE_ADRESSE_DRIVE</excludedEnvironmentVariable>
            <excludedEnvironmentVariable>RECUS_COPIE_ADRESSE_SHEETS</excludedEnvironmentVariable>
            <excludedEnvironmentVariable>RECUS_COPIE_ADRESSE_LIEN_FICHIER</excludedEnvironmentVariable>
            <excludedEnvironmentVariable>RECUS_COPIE_ANNEES_2024_FICHIER</excludedEnvironmentVariable>
            <excludedEnvironmentVariable>RECUS_COPIE_ANNEES_2024_ONGLET</excludedEnvironmentVariable>
            <excludedEnvironmentVariable>RECUS_COPIE_ANNEES_2025_FICHIER</excludedEnvironmentVariable>
            <excludedEnvironmentVariable>RECUS_COPIE_ANNEES_2025_ONGLET</excludedEnvironmentVariable>
            <excludedEnvironmentVariable>RECUS_COPIE_ANNEES_2026_FICHIER</excludedEnvironmentVariable>
            <excludedEnvironmentVariable>RECUS_COPIE_ANNEES_2026_ONGLET</excludedEnvironmentVariable>
            <excludedEnvironmentVariable>RECUS_COPIE_ANNEES_2027_FICHIER</excludedEnvironmentVariable>
            <excludedEnvironmentVariable>RECUS_COPIE_ANNEES_2027_ONGLET</excludedEnvironmentVariable>
            <excludedEnvironmentVariable>RECUS_COPIE_ANNEES_2028_FICHIER</excludedEnvironmentVariable>
            <excludedEnvironmentVariable>RECUS_COPIE_ANNEES_2028_ONGLET</excludedEnvironmentVariable>
            <excludedEnvironmentVariable>RECUS_COPIE_ANNEES_2029_FICHIER</excludedEnvironmentVariable>
            <excludedEnvironmentVariable>RECUS_COPIE_ANNEES_2029_ONGLET</excludedEnvironmentVariable>
            <excludedEnvironmentVariable>RECUS_COPIE_ANNEES_2030_FICHIER</excludedEnvironmentVariable>
            <excludedEnvironmentVariable>RECUS_COPIE_ANNEES_2030_ONGLET</excludedEnvironmentVariable>
            <excludedEnvironmentVariable>RECUS_SECURITE_CONDENSE_MOT_DE_PASSE</excludedEnvironmentVariable>
            <excludedEnvironmentVariable>RECUS_SECURITE_ECHECS_AVANT_BLOCAGE</excludedEnvironmentVariable>
            <excludedEnvironmentVariable>RECUS_SECURITE_DUREE_BLOCAGE</excludedEnvironmentVariable>
            <excludedEnvironmentVariable>RECUS_SECURITE_SOURCES_SUIVIES_MAX</excludedEnvironmentVariable>
            <excludedEnvironmentVariable>RECUS_SECURITE_CORPS_REQUETE_MAX</excludedEnvironmentVariable>
            <excludedEnvironmentVariable>RECUS_SECURITE_COOKIE_SECURISE</excludedEnvironmentVariable>
            <excludedEnvironmentVariable>ANTHROPIC_API_KEY</excludedEnvironmentVariable>
          </excludedEnvironmentVariables>
        </configuration>
      </plugin>
      <!-- Couverture des tests, sans seuil : rapport dans target/site/jacoco/. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>test</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!-- Analyse statique de sécurité dans verify : le build échoue sur une faille. Exclusions ciblées et justifiées dans spotbugs-exclude.xml. -->
      <plugin>
        <groupId>com.github.spotbugs</groupId>
        <artifactId>spotbugs-maven-plugin</artifactId>
        <version>${spotbugs-plugin.version}</version>
        <configuration>
          <effort>Max</effort>
          <threshold>Low</threshold>
          <excludeFilterFile>spotbugs-exclude.xml</excludeFilterFile>
          <plugins>
            <plugin>
              <groupId>com.h3xstream.findsecbugs</groupId>
              <artifactId>findsecbugs-plugin</artifactId>
              <version>${findsecbugs.version}</version>
            </plugin>
          </plugins>
        </configuration>
        <executions>
          <execution>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- A06 : dépendances vulnérables. Exige une clé NVD (-Dnvd.api.key, secret NVD_API_KEY en CI). -->
    <profile>
      <id>security</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.owasp</groupId>
            <artifactId>dependency-check-maven</artifactId>
            <version>${dependency-check.version}</version>
            <configuration>
              <nvdApiKey>${nvd.api.key}</nvdApiKey>
              <failBuildOnCVSS>7</failBuildOnCVSS>
              <ossIndexAnalyzerEnabled>false</ossIndexAnalyzerEnabled>
              <retireJsAnalyzerEnabled>false</retireJsAnalyzerEnabled>
            </configuration>
            <executions>
              <execution>
                <goals>
                  <goal>check</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!--
      Essai manuel d'un vrai appel au modèle, hors de test et de verify (src/essai n'est compilé que dans ce profil).
      La clé vient de l'environnement, jamais de la ligne de commande (voir docs/deploiement.md), par exemple sous macOS :
      export ANTHROPIC_API_KEY="$(security find-generic-password -a "$USER" -s anthropic-api-key -w)"
      ./mvnw -q -Pessai-reel compile exec:java -Dphoto=/chemin/hors/depot/recu.jpg
      Facultatif : -Dcote.max=2400 (long côté de la copie envoyée), -Dmodele=claude-haiku-5-5.
    -->
    <profile>
      <id>essai-reel</id>
      <properties>
        <photo>${project.basedir}/photo-non-indiquee</photo>
        <cote.max>1568</cote.max>
        <modele>claude-haiku-5-5</modele>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>build-helper-maven-plugin</artifactId>
            <version>${build-helper-plugin.version}</version>
            <executions>
              <execution>
                <id>sources-essai</id>
                <phase>generate-sources</phase>
                <goals>
                  <goal>add-source</goal>
                </goals>
                <configuration>
                  <sources>
                    <source>src/essai/java</source>
                  </sources>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>${exec-plugin.version}</version>
            <configuration>
              <mainClass>realreading.RealReadingTrial</mainClass>
              <arguments>
                <argument>${photo}</argument>
                <argument>${cote.max}</argument>
                <argument>${modele}</argument>
              </arguments>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
